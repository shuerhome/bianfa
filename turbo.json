{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "lint": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "env": ["NODE_ENV"] },
    "test:integration": { "dependsOn": ["build"], "cache": false, "env": ["DATABASE_URL", "DATABASE_URL_DIRECT", "DATABASE_DIRECT_URL", "REDIS_URL"] },
    "test:e2e": { "dependsOn": ["build"], "cache": false, "env": ["API_BASE_URL", "SYNC_WS_URL"] },
    "db:migrate": { "cache": false, "env": ["DATABASE_URL"] }
  }
}
