{
  "name": "@bianfa/cf-healthcheck-worker",
  "private": true,
  "type": "module",
  "description": "bianfa 黑盒探测 Worker：Cron 每分钟打 /healthz，连续失败推 Telegram（infra/cloudflare/healthcheck-worker）",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail --format pretty"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260905.1",
    "typescript": "7.0.2",
    "wrangler": "4.129.0"
  }
}
