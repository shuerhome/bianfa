# =============================================================================
# bianfa · 生产环境变量清单（模板）—— 复制为 /srv/bianfa/.env.prod 后填值；.env.prod 永不进 git
# -----------------------------------------------------------------------------
# 来源：第 9 章 8.5（密钥管理：CI 从 GitHub Environment secrets 渲染 → scp → root:root 0600）、
#       第 1 章 S5（R2 三把 key）、S3（两条 DSN）、C8（Redis 纯 ephemeral）、第 10 章 9.4.3、
#       infra/vps/{deploy,backup,break-glass,notify}.sh 与 RUNBOOK 读取的变量名。
# 使用：docker compose --project-directory /srv/bianfa/app/infra/docker --env-file /srv/bianfa/.env.prod …
#       （compose 只自动读 ./.env，本栈刻意不用那个名字。）
#
# 规则：
#   * 每个值都标注「来源」与「怎么生成」。<REPLACE_ME:…> 必须替换（deploy.sh / backup.sh 见到 REPLACE_ME 会拒绝运行）；
#     写着 [可选] 的可留空。
#   * 会拼进 URL 的密码（PG_APP_PASSWORD / PG_WORKER_PASSWORD / PG_EXPORTER_PASSWORD / REDIS_PASSWORD）只用 hex：
#       openssl rand -hex 32     → 无需 URL 编码，也不会撞上 redis.conf 的空格/引号解析。
#   * 一个进程只拿它需要的变量（compose 里按服务显式映射，没有 env_file: 全量灌入）。
#   * 所有值的权威副本在 GitHub Environment `prod` 的 secrets 里；VPS 上的 .env.prod 是渲染产物。
#
# 必须人工替换的值（本文件内全部 <REPLACE_ME:…>）：
#   TAG · BIANFA_DOMAIN · CF_TUNNEL_TOKEN · TG_BOT_TOKEN · TG_CHAT_ID · POSTGRES_PASSWORD · PG_APP_PASSWORD ·
#   PG_WORKER_PASSWORD · PG_EXPORTER_PASSWORD · REDIS_PASSWORD · APP_ORIGIN · BETTER_AUTH_SECRET · SYNC_TOKEN_SECRET · R2_ACCOUNT_ID ·
#   R2_ATTACHMENTS_ACCESS_KEY_ID · R2_ATTACHMENTS_SECRET_ACCESS_KEY · PGBACKREST_REPO1_S3_KEY ·
#   PGBACKREST_REPO1_S3_KEY_SECRET · PGBACKREST_REPO1_CIPHER_PASS · RESEND_API_KEY · MAIL_FROM ·
#   GRAFANA_CLOUD_PROM_URL · GRAFANA_CLOUD_PROM_USER · GRAFANA_CLOUD_LOKI_URL · GRAFANA_CLOUD_LOKI_USER · GRAFANA_CLOUD_API_KEY
# =============================================================================

# ---------------------------------------------------------------------------
# 0. 部署元数据（compose + 脚本共用）
# ---------------------------------------------------------------------------
# 镜像 tag：deploy.sh 用 `export TAG=<tag>` 覆盖；但 cron / backup.sh / restore.sh 只带 --env-file 调 compose exec，
# 那时 compose 仍要解析 api 镜像名 → 这里必须是一个**真实推送过的 tag**（CI 渲染时写入本次发布的 tag）。
TAG=<REPLACE_ME:image-tag>
# 镜像仓库前缀（ghcr.io/<org>）。仓库改名时改这里，compose 不用动。
IMAGE_REGISTRY=ghcr.io/shuerhome
# 根域：compose 拼 https://api.<domain> 给 api（PUBLIC_API_URL / BETTER_AUTH_URL）；deploy.sh 用它做外部 /healthz 探测；
# break-glass.sh 用它生成 https 站点。只填裸域，不带 https://、不带 api.
BIANFA_DOMAIN=<REPLACE_ME:example.com>
# [可选] break-glass ACME 模式的 Let's Encrypt 联系邮箱（break-glass.sh 读取；主 Caddyfile 已有全局块时不注入，留空即可）
ACME_EMAIL=
# Node 应用日志级别（pino）：info / warn。Alloy 只把 warn+ 推到 Loki，本地 json-file 留 50m×3。
LOG_LEVEL=info
# 给 Grafana Cloud 打的 host 标签（换机器时改，便于对比）
VPS_HOSTNAME=bianfa-vps-1

# ---------------------------------------------------------------------------
# 1. Cloudflare Tunnel（8.4：VPS 零入站端口）
# ---------------------------------------------------------------------------
# 来源：Cloudflare Zero Trust → Networks → Tunnels → 建 remote-managed tunnel `bianfa-prod` → 复制 token。
# 两个 cloudflared 副本共用同一个 token（同一 tunnel 的两个 connector = 原生 HA）。
# 公共主机名 → 服务映射在控制台配：api.<domain> → http://caddy:80（WebSocket 同一入口，见 infra/vps/tunnel-setup.md）
CF_TUNNEL_TOKEN=<REPLACE_ME:cloudflare-tunnel-token>

# ---------------------------------------------------------------------------
# 2. Telegram（infra/vps/notify.sh：deploy / backup / break-glass / restore 的结果推送；不进任何容器）
# ---------------------------------------------------------------------------
# 来源：@BotFather 建 bot 取 token；chat id 用 getUpdates 取
TG_BOT_TOKEN=<REPLACE_ME:telegram-bot-token>
TG_CHAT_ID=<REPLACE_ME:telegram-chat-id>

# ---------------------------------------------------------------------------
# 3. PostgreSQL（自建镜像；超级用户名固定为 postgres，见 pg_hba.conf 的 local peer 说明）
# ---------------------------------------------------------------------------
# 超级用户密码：仅初始化、迁移、紧急运维使用；应用永不使用。 openssl rand -hex 32
POSTGRES_PASSWORD=<REPLACE_ME:openssl rand -hex 32>
POSTGRES_DB=bianfa
# 应用角色（api / sync-ws 使用，受 RLS；经 PgBouncer；非 owner → RLS 生效）。由 pg/initdb/01-roles-and-extensions.sh 首次启动创建。
PG_APP_USER=bianfa_app
PG_APP_PASSWORD=<REPLACE_ME:openssl rand -hex 32>
# 监控角色（pg_monitor 只读；Alloy postgres_exporter 直连）
PG_EXPORTER_USER=bianfa_exporter
PG_EXPORTER_PASSWORD=<REPLACE_ME:openssl rand -hex 32>
# worker 角色（仅 worker 进程：projector / 附件 GC / 邮件 / 结算；BYPASSRLS，规格 02 §9-16）。同样由 initdb 脚本首次启动创建，
# 同样经 PgBouncer（compose 把它和 PG_APP_USER 一起写进 PgBouncer 的 userlist）。
PG_WORKER_USER=bianfa_worker
PG_WORKER_PASSWORD=<REPLACE_ME:openssl rand -hex 32>
# 由 compose 拼出的 DSN（不需要在这里写）：
#   DATABASE_URL        = postgres://$PG_APP_USER:$PG_APP_PASSWORD@pgbouncer:5432/$POSTGRES_DB   （api / sync-ws）
#   DATABASE_URL        = postgres://$PG_WORKER_USER:$PG_WORKER_PASSWORD@pgbouncer:5432/$POSTGRES_DB （worker）
#   DATABASE_URL_DIRECT = postgres://$PG_APP_USER:$PG_APP_PASSWORD@postgres:5432/$POSTGRES_DB    （仅 sync-ws，LISTEN 专用，S3）
#   PG_EXPORTER_DSN     = postgresql://$PG_EXPORTER_USER:…@postgres:5432/$POSTGRES_DB?sslmode=disable（仅 alloy）

# ---------------------------------------------------------------------------
# 4. Redis（C8：无持久数据，只做 Hocuspocus 广播 + 限流计数）
# ---------------------------------------------------------------------------
# openssl rand -hex 32 。compose 启动时写入 /tmp/redis-secret.conf 再 --include，不上命令行。
REDIS_PASSWORD=<REPLACE_ME:openssl rand -hex 32>
# 由 compose 拼出：REDIS_URL = redis://:$REDIS_PASSWORD@redis:6379/0 （api / sync-ws；worker 不拿）

# ---------------------------------------------------------------------------
# 5. 应用层（与 apps/api、apps/sync 的接口契约；改名需同步）
# ---------------------------------------------------------------------------
# 允许的 origin 列表（逗号分隔，由 api 自己 split；第 10 章 9.4.3：精确匹配、不通配、不反射）。
# **第一个必须是 https://api.<BIANFA_DOMAIN>**：Web 面（登录 / 注册 / 找回密码 / 邮箱验证 / OAuth 同意 / 设备码 /device /
# 邀请 /invite/<token> / 账号页）由 api 进程在这个 origin 同源托管（apps/server/src/http/web-static.ts），
# 邮件里的链接、Better Auth 的 loginPage / consentPage / device verification_uri 都指向它，cookie 因此保持同源。
# 后面再跟 Tauri 桌面端 origin：tauri://localhost（macOS）/ http://tauri.localhost（Windows）。
APP_ORIGIN=<REPLACE_ME:https://api.example.com,tauri://localhost,http://tauri.localhost>
# Better Auth 签名/加密密钥： openssl rand -base64 48
BETTER_AUTH_SECRET=<REPLACE_ME:openssl rand -base64 48>
# [可选] Web 账号页「下载桌面端」按钮指向的 https 链接；留空则不显示按钮
DESKTOP_DOWNLOAD_URL=
# api 签发、sync-ws 校验的 60s 短期 JWT 的 HMAC 密钥（第 5 章：token 走 Hocuspocus auth 帧不走 URL）： openssl rand -base64 48
SYNC_TOKEN_SECRET=<REPLACE_ME:openssl rand -base64 48>

# ---------------------------------------------------------------------------
# 6. Cloudflare R2 —— 三把 key（S5）。每把 key 只绑定一个桶（Object Read & Write，R2 没有「只写」档，见 infra/cloudflare/r2.md §6）。
#    来源：Cloudflare 控制台 → R2 → Manage R2 API Tokens → **Account API token**，每桶单独建。
# ---------------------------------------------------------------------------
# 账户 ID（Cloudflare 控制台 R2 概览页）；S3 endpoint = <ACCOUNT_ID>[.<法域>].r2.cloudflarestorage.com（compose 拼给 pgBackRest）
R2_ACCOUNT_ID=<REPLACE_ME:cloudflare-account-id>
# 备份桶的法域：控制台建桶时选「自动」或「位置提示」→ 留空；选「指定管辖区 → 欧盟」→ 填 eu。建桶后不可改，端点跟着它走。
R2_BACKUPS_JURISDICTION=

# (a) attachments —— token `bianfa-attachments-rw`，**仅 api / worker 进程使用**：签 presigned PUT/GET、GC 删除。
#     绝不下发客户端；客户端只拿到 5–15 分钟有效的 presigned URL（S1）。
R2_ATTACHMENTS_BUCKET=bianfa-attachments
R2_ATTACHMENTS_ACCESS_KEY_ID=<REPLACE_ME:r2-attachments-access-key-id>
R2_ATTACHMENTS_SECRET_ACCESS_KEY=<REPLACE_ME:r2-attachments-secret-access-key>

# (b) backups —— token `bianfa-backups-rw`，**仅 postgres 容器使用**（pgBackRest）。变量名直接用 pgBackRest 的环境变量名，
#     compose 原样传入，backup.sh / restore.sh / RUNBOOK 也按这几个名字检查。桶**不开** bucket lock（r2.md §4.2）。
PGBACKREST_REPO1_S3_KEY=<REPLACE_ME:r2-backups-access-key-id>
PGBACKREST_REPO1_S3_KEY_SECRET=<REPLACE_ME:r2-backups-secret-access-key>
# pgBackRest 仓库加密口令（8.7）： openssl rand -hex 32 。权威副本存密码管理器 + GitHub Environment secret（restore 演练用同一口令）；
# 这里只是渲染产物。丢失 = 全部备份不可解 —— 与 minisign 私钥同级别的「不可恢复单点」，必须两处离线备份。
PGBACKREST_REPO1_CIPHER_PASS=<REPLACE_ME:openssl rand -hex 32>

# (c) releases —— token `bianfa-releases-ci`，**仅 GitHub Actions 发布流水线使用，不应出现在 VPS 的 .env.prod 里**。
#     列在此处只为 S5 三把 key 的完整清单；渲染 .env.prod 时请跳过（保持注释状态）。
# R2_RELEASES_ACCESS_KEY_ID=<CI-ONLY:GitHub Environment "release" secret>
# R2_RELEASES_SECRET_ACCESS_KEY=<CI-ONLY:GitHub Environment "release" secret>

# ---------------------------------------------------------------------------
# 7. LLM 上游（第 8 章）。默认 BYOK，平台 key 仅供固定额度试用；全部 [可选]，留空即关闭该家托管调用。仅 api 进程持有。
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
AZURE_AI_API_KEY=
AZURE_AI_ENDPOINT=

# ---------------------------------------------------------------------------
# 8. 事务邮件（第 6 章：VPS 自建 SMTP 必进垃圾箱，用托管发信）。api + worker。
# ---------------------------------------------------------------------------
# 来源：Resend 控制台 → API Keys（Sending access only）。域名需先配好 SPF/DKIM/DMARC。
RESEND_API_KEY=<REPLACE_ME:resend-api-key>
# 含空格与尖括号 → 必须加双引号（compose --env-file 支持 dotenv 双引号）
MAIL_FROM="<REPLACE_ME:bianfa <no-reply@example.com>>"

# ---------------------------------------------------------------------------
# 9. 计费（第 7 章 / M4 前 [可选]）。api（+ worker 结算）。
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# 10. Sentry SaaS（S6：应用侧 sendDefaultPii=false / includeLocalVariables=false / beforeSend 白名单）。[可选]
# ---------------------------------------------------------------------------
# 来源：Sentry → Project Settings → Client Keys (DSN)。api 与 sync-ws 分两个 project，便于分别限额。
SENTRY_DSN_API=
SENTRY_DSN_SYNC=

# ---------------------------------------------------------------------------
# 11. Grafana Cloud（8.8：监控不与被监控对象同机）。仅 alloy 进程持有。
# ---------------------------------------------------------------------------
# 来源：Grafana Cloud 控制台 → Stack → Prometheus「Details」：Remote Write Endpoint + Username(数字 instance id)；
#       Loki「Details」：URL + User。API key：Security → Access Policies → 建一个只有 metrics:write + logs:write 的 token。
GRAFANA_CLOUD_PROM_URL=https://<REPLACE_ME:prometheus-prod-xxx>.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=<REPLACE_ME:prometheus-instance-id>
GRAFANA_CLOUD_LOKI_URL=https://<REPLACE_ME:logs-prod-xxx>.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=<REPLACE_ME:loki-instance-id>
GRAFANA_CLOUD_API_KEY=<REPLACE_ME:grafana-cloud-access-policy-token>

# ---------------------------------------------------------------------------
# 12. 不在 VPS 上、但属于同一套「生产密钥」的东西（只列名，防止遗漏；全部只在 GitHub Environment secrets）
# ---------------------------------------------------------------------------
# TAURI_SIGNING_PRIVATE_KEY / TAURI_SIGNING_PRIVATE_KEY_PASSWORD   —— updater minisign 私钥（第 3 章 2.4，丢失不可恢复）
# APPLE_API_KEY_ID / APPLE_API_ISSUER_ID / APPLE_API_KEY(base64) / APPLE_CERTIFICATE(.p12 base64) / APPLE_CERTIFICATE_PASSWORD
# AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET / AZURE_SIGNING_ENDPOINT / AZURE_SIGNING_ACCOUNT / AZURE_SIGNING_PROFILE
# CF_API_TOKEN（更新清单 Worker 部署 / KV 灰度开关）
# R2_BACKUPS_RO_*（restore 演练用只读 token `bianfa-backups-ro`；VPS 上没有）
# VPS_SSH_HOST_KEY / CF_ACCESS_*（cloudflared access ssh，CI 部署用）
