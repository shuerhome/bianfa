{
  "name": "@bianfa/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch src/api.ts",
    "dev:sync": "tsx watch src/sync.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@aws-sdk/s3-request-presigner": "3.1127.0",
    "@bianfa/shared": "workspace:*",
    "@hocuspocus/extension-redis": "4.6.0",
    "@hocuspocus/server": "4.6.0",
    "@hono/node-server": "2.1.1",
    "@hono/zod-validator": "0.9.1",
    "@sentry/node": "10.73.0",
    "better-auth": "1.7.3",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "lib0": "0.2.117",
    "pg": "8.23.0",
    "pg-boss": "12.30.0",
    "pino": "10.3.1",
    "resend": "6.26.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.32",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@hocuspocus/provider": "4.6.0",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "ws": "8.21.3"
  }
}
